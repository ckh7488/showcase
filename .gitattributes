* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.bin binary
# Preserve the original simulation evidence bytes and their SHA-256 checksums.
/reports/porta-pcb/records/tx-recheck/*-fem-checks.json -text
# RFCP CAD and calculation records carry source-byte checksums.
/reports/rf-current-probe/split-a14/** -text
/reports/rf-current-probe/files/parts/** -text
/reports/rf-current-probe/assembly/*.step -text
/reports/rf-current-probe/impedance-files/** -text
/reports/rf-current-probe/records/** -text
